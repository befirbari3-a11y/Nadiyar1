function updatePageMeters(){
  document.querySelectorAll('.pbox').forEach((box,pi)=>{
    const a4=box.querySelector('.a4'),fill=box.querySelector('.pbar-fill'),txt=box.querySelector('.pbar-txt');
    if(!a4||!fill||!txt||a4.offsetHeight===0)return;
    const hdrH=a4.querySelector('.ehdr')?.offsetHeight||0;
    const qzH=a4.querySelector('.qz')?.offsetHeight||0;
    const fw=a4.querySelector('.freewrite');
    const fwH=(fw&&fw.innerText.trim().length)?fw.offsetHeight:0;
    const maxH=a4.clientHeight-95; // printable vertical budget inside A4 (297mm minus margins/footer)
    const usedH=hdrH+qzH+fwH;
    const pct=Math.max(0,Math.round((usedH/Math.max(400,maxH))*100));
    const rem=Math.max(0,100-pct);
    const qCnt=Q.filter(q=>Math.min(q.pg,pages.length-1)===pi&&!isNoHdr(q.tp)).length;
    fill.style.width=Math.min(100,pct)+'%';
    fill.style.background=pct>96?'#dc2626':(pct>80?'#d97706':'#16a34a');
    txt.style.color=pct>96?'#dc2626':(pct>80?'#b45309':'#15803d');
    txt.textContent=pct>98
      ?`⚠️ پەڕێ ${pi+1} پڕ بوو (${pct}%) — پرسیار: ${qCnt} | پرسیارەکێ بڤەگوهێزە پەڕێ ${pi+2}`
      :`پەڕێ ${pi+1} | پرسیار: ${qCnt} | پڕبوون: ${pct}% — جھێ مای: ${rem}%`;
  });
}

