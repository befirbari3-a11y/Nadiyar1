    if(e.dataset.locked==='1'){const ed=ev.target.closest('[contenteditable="true"]');if(ed)ed.focus();return;}
    const inCell=ev.target.closest('td,th,.freetxt,.medcirc'),sx=ev.clientX,sy=ev.clientY,sl=parseFloat(e.style.left)||0,st=parseFloat(e.style.top)||0,pg=e.closest('.a4'),r=pg?pg.getBoundingClientRect():null,sc=(r&&r.width)?(r.width/pg.offsetWidth):1;
    let moved=false;
    const mv=m=>{if(Math.hypot(m.clientX-sx,m.clientY-sy)>(inCell?10:4)){moved=true;e.style.left=(sl+(m.clientX-sx)/sc)+'px';e.style.top=(st+(m.clientY-sy)/sc)+'px';}};
    const up=()=>{document.removeEventListener('pointermove',mv);document.removeEventListener('pointerup',up);document.removeEventListener('pointercancel',up);if(moved){snap();schedSave();saveCert();}else{const ed=ev.target.closest('[contenteditable="true"]');if(ed)ed.focus();}};
    document.addEventListener('pointermove',mv);document.addEventListener('pointerup',up);document.addEventListener('pointercancel',up);
  });
  if(rzH)rzH.addEventListener('pointerdown',ev=>{
    if(e.dataset.locked==='1')return;
    ev.preventDefault();ev.stopPropagation();try{rzH.setPointerCapture(ev.pointerId);}catch(err){}
    const sx=ev.clientX,sy=ev.clientY,sw=parseFloat(e.style.width)||e.offsetWidth,sh=parseFloat(e.style.height)||e.offsetHeight,pg=e.closest('.a4'),r=pg?pg.getBoundingClientRect():null,sc=(r&&r.width)?(r.width/pg.offsetWidth):1;
    const mv=m=>{e.style.width=Math.max(30,sw+(m.clientX-sx)/sc)+'px';e.style.height=Math.max(20,sh+(m.clientY-sy)/sc)+'px';if(e.dataset.mc==='1')e.style.fontSize=Math.max(10,Math.round((sh+(m.clientY-sy)/sc)/4.2))+'px';};
    const up=()=>{rzH.removeEventListener('pointermove',mv);rzH.removeEventListener('pointerup',up);rzH.removeEventListener('pointercancel',up);snap();schedSave();saveCert();};
    rzH.addEventListener('pointermove',mv);rzH.addEventListener('pointerup',up);rzH.addEventListener('pointercancel',up);
  });
}

document.addEventListener('focusin',e=>{const ed=e.target.closest&&e.target.closest('[contenteditable="true"]');if(ed){actEd=ed;snap();}});
