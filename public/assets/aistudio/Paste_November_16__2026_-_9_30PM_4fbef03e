function restR(){if(actEd&&document.activeElement!==actEd)actEd.focus({preventScroll:true});const s=getSelection();if(rng){try{s.removeAllRanges();s.addRange(rng);}catch(e){}}return actEd;}
function fmt(c){const el=restR();if(!el)return;const s=getSelection(),hasSel=s.rangeCount&&!s.isCollapsed&&el.contains(s.anchorNode);if(hasSel)document.execCommand(c,false,null);else{if(c==='bold')el.style.fontWeight=el.style.fontWeight==='800'?'400':'800';if(c==='italic')el.style.fontStyle=el.style.fontStyle==='italic'?'normal':'italic';if(c==='underline')el.style.textDecoration=el.style.textDecoration==='underline'?'none':'underline';}el.dispatchEvent(new Event('input',{bubbles:true}));schedSnap();}
