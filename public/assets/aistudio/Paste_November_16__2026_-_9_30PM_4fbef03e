    if(!Q[qi].free){Q[qi].free=true;Q[qi].x=Math.round((qr.left-r0.left)/sc);Q[qi].y=Math.round((qr.top-r0.top)/sc);Q[qi].w=Math.round(qb.offsetWidth);qb.classList.add('qfree');qb.style.left=Q[qi].x+'px';qb.style.top=Q[qi].y+'px';qb.style.width=Q[qi].w+'px';}
