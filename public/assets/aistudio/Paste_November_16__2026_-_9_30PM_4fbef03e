function curSnap(){syncPagesFromDOM();const inp={};FLDS.forEach(([k])=>inp[k]=V('i-'+k));return JSON.stringify({lang,numMode,pages,Q,inp,hdrLocked,hdrLogo,hdrLogoPos,hdrLogoSz});}
function snap(){const s=curSnap();if(hist[hist.length-1]!==s){hist.push(s);if(hist.length>40)hist.shift();}}
function schedSnap(){clearTimeout(hTm);hTm=setTimeout(snap,650);}
function undoAct(){
  if(document.body.classList.contains('cert-mode')){document.execCommand('undo');return;}
  const cur=curSnap();while(hist.length&&hist[hist.length-1]===cur)hist.pop();
  if(!hist.length){document.execCommand('undo');return;}
  const s=JSON.parse(hist.pop());lang=s.lang;numMode=s.numMode;pages=s.pages;Q=s.Q;
  hdrLocked=!!s.hdrLocked;hdrLogo=s.hdrLogo||'';hdrLogoPos=s.hdrLogoPos||'center';hdrLogoSz=s.hdrLogoSz||54;
  if(s.inp)Object.keys(s.inp).forEach(k=>{if($('i-'+k))$('i-'+k).value=s.inp[k];});
  applyHdrLockUI();renderQTab();renderA4();schedSave();
}

