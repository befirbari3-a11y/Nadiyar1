function szTxt(m){const el=restR();if(!el)return;const s=getSelection();if(!s.rangeCount||s.isCollapsed){const cur=parseFloat(getComputedStyle(el).fontSize)||15;el.style.fontSize=Math.max(8,Math.min(48,Math.round(cur*m)))+'px';el.dispatchEvent(new Event('input',{bubbles:true}));return;}const r=s.getRangeAt(0),sp=document.createElement('span'),cur=parseFloat(getComputedStyle(el).fontSize)||15;sp.style.fontSize=Math.max(8,Math.min(48,Math.round(cur*m)))+'px';try{r.surroundContents(sp);}catch(e){sp.appendChild(r.extractContents());r.insertNode(sp);}const nr=document.createRange();nr.selectNodeContents(sp);s.removeAllRanges();s.addRange(nr);rng=nr.cloneRange();el.dispatchEvent(new Event('input',{bubbles:true}));schedSnap();}

document.addEventListener('paste',e=>{
  const ed=e.target.closest&&e.target.closest('[contenteditable="true"]');if(!ed)return;
  const cd=e.clipboardData;if(!cd)return;
  for(const item of cd.items||[]){if(item.type.startsWith('image/')){e.preventDefault();const f=item.getAsFile(),r=new FileReader();r.onload=ev=>{if(ed.closest('#wrap'))mkFel(`<img src="${ev.target.result}" style="width:100%;height:100%;object-fit:contain;pointer-events:none">`,180,140);else document.execCommand('insertHTML',false,`<img src="${ev.target.result}" style="max-width:100%;height:auto">`);};r.readAsDataURL(f);return;}}
  const html=cd.getData('text/html');
  if(html&&(html.includes('Mso')||html.includes('urn:schemas-microsoft-com')||html.includes('<table'))){
    e.preventDefault();const doc=new DOMParser().parseFromString(html.replace(/<!--[\s\S]*?-->/g,''),'text/html');
    doc.querySelectorAll('style,meta,link,script,xml,o\\:p').forEach(x=>x.remove());
    doc.querySelectorAll('*').forEach(el=>{el.removeAttribute('class');el.removeAttribute('width');el.removeAttribute('height');if(el.tagName==='TABLE'){el.className='et';el.style.cssText='width:100%;border-collapse:collapse;table-layout:fixed;margin:4px 0';}else if(el.tagName==='TD'||el.tagName==='TH'){el.setAttribute('contenteditable','true');el.style.cssText='border:1px solid #334155;padding:3px 5px';}else if(el.tagName==='IMG'){el.style.cssText='max-width:100%;height:auto';}else{const b=el.style.fontWeight,it=el.style.fontStyle,u=el.style.textDecoration,col=el.style.color;el.removeAttribute('style');if(b)el.style.fontWeight=b;if(it)el.style.fontStyle=it;if(u)el.style.textDecoration=u;if(col)el.style.color=col;}});
    document.execCommand('insertHTML',false,doc.body.innerHTML);ed.dispatchEvent(new Event('input',{bubbles:true}));schedSnap();
  }
});

function buildWordHTML(){
  saveNow();renderA4();const d=L[lang],tot=calcTot();
  const logoH=hdrLogo?`<img src="${hdrLogo}" width="${hdrLogoSz}">`:'';
  const body=pages.map((pg,pi)=>{
    let h='';
    if(pg.hdr){
      const row=(k,txt)=>C('c-'+k)?`<div>${txt}</div>`:'';
      h+=`<table width="100%" style="border-bottom:2px solid ${V('chd')};margin-bottom:8px;color:${V('chd')};font-size:12px"><tr>
        <td width="38%" valign="top">${hdrLogoPos==='right'?logoH:''}${row('min',V('i-min'))}${row('sch',V('i-sch'))}${C('c-sub')||C('c-grd')?`<div>${C('c-sub')?V('i-sub'):''} &nbsp; ${C('c-grd')?V('i-grd'):''}</div>`:''}${row('tch',V('i-tch'))}</td>
        <td width="24%" align="center" valign="top">${row('bis',`<b>${V('i-bis')}</b>`)}${hdrLogoPos==='center'?logoH:''}${C('c-typ')||C('c-yr')?`<div style="border:1.5px solid ${V('chd')};padding:4px 8px;margin-top:3px"><b>${C('c-typ')?V('i-typ'):''}</b><br><small>${C('c-yr')?V('i-yr'):''}</small></div>`:''}</td>
        <td width="38%" valign="top">${hdrLogoPos==='left'?`<div align="left">${logoH}</div>`:''}${row('stu',`<b>${V('i-stu')}</b> ____________`)}${C('c-dat')||C('c-tim')?`<div style="border-top:1px solid #ccc;border-bottom:1px solid #ccc;padding:2px 0;margin:2px 0">${C('c-dat')?V('i-dat'):''} &nbsp;|&nbsp; ${C('c-tim')?V('i-tim'):''}</div>`:''}${row('scr',`${d.sl} <span style="border:1.5px solid ${V('chd')};padding:1px 8px"><b>${tot}</b></span>`)}</td>
      </tr></table>`;
    }
    const qs=Q.map((q,qi)=>({q,qi})).filter(x=>Math.min(x.q.pg,pages.length-1)===pi);
    const qH=qs.map(({q,qi})=>{
      const nh=isNoHdr(q.tp);let num=0;for(let i=0;i<=qi;i++)if(!isNoHdr(Q[i].tp))num++;
      let bd='';
      if(q.tp==='match')bd=`<table width="100%" style="margin:4px 0">${(q.items||[]).map((it,ii)=>`<tr><td width="50%" style="padding:3px">${fmtN(ii+1)}- ${it.a}</td><td width="50%" style="padding:3px">${d.mL[ii]||(ii+1)+'-'} ${it.b}</td></tr>`).join('')}</table>`;
      else if(q.tp==='concept')bd=`<p align="center"><b>[ ${q.center} ]</b><br>${(q.branches||[]).map(b=>`[ ${b} ]`).join(' &nbsp; ')}</p>`;
      else if(q.tp==='count'){let rows='';for(let i=0;i<(q.items||[]).length;i+=4){rows+='<tr>'+q.items.slice(i,i+4).map((it,k)=>`<td width="25%" valign="top">${fmtN(i+k+1)}- ${it.html}</td>`).join('')+'</tr>';}bd=`<table width="100%" style="margin:3px 0">${rows}</table>`;}
      else{if(q.tp==='img'&&q.img)bd+=`<p><img src="${q.img}" width="${q.w}"></p>`;bd+=(q.items||[]).map((it,ii)=>`<div style="margin-bottom:3px">${nh?'':`${fmtN(ii+1)}- `}${it.html}${q.tp==='mcq'?`<table width="100%" style="margin-top:2px"><tr>${(it.opts||[]).map((o,oi)=>`<td width="25%">${d.op[oi]} ${o.html}</td>`).join('')}</tr></table>`:''}${q.tp==='callig'?'<div style="border-bottom:1px solid #888;height:20px"></div><div style="border-bottom:1px solid #888;height:20px"></div>':''}</div>`).join('');if(q.sp)bd+=`<div style="height:${q.sp}px"></div>`;}
      if(q.hw)bd+='<div style="border-bottom:1px solid #888;height:22px"></div>'.repeat(q.hw);
      const hdrQ=nh?'':`<table width="100%" style="color:${V('cqh')};font-weight:bold;margin:6px 0 3px"><tr><td>${d.qp}${fmtN(num)}/ ${q.title}</td><td align="${d.dir==='rtl'?'left':'right'}" width="110">(${q.mk} ${d.mw})</td></tr></table>`;
      return `<div style="${q.bg?`background-color:${q.bg};padding:6px;`:''}${nh||q.tp==='free'||q.noLine?'':'border-bottom:1px solid #cbd5e1;padding-bottom:6px;'}margin-bottom:8px">${hdrQ}${bd}</div>`;
    }).join('');
    const fw=pg.txt?`<div>${pg.txt}</div>`:'';
    const flDiv=document.createElement('div');flDiv.innerHTML=pg.fl||'';let flH='';
    flDiv.querySelectorAll('.et,img,.freetxt,.medcirc').forEach(el=>{if(el.tagName==='TABLE'){el.setAttribute('border','1');el.style.borderCollapse='collapse';flH+=el.outerHTML+'<br>';}else if(el.tagName==='IMG')flH+=`<p><img src="${el.src}" width="180"></p>`;else flH+=`<div style="padding:4px 0">${el.innerHTML}</div>`;});
    const ft=pg.hdr&&C('c-ft')?`<p align="center" style="margin-top:16px;font-weight:bold;color:${V('chd')}">${V('i-ft')}</p>`:'';
    return `<div style="border:1.5px solid ${V('cfr')};background-color:${V('cbg')};color:${V('ctxt')||'#000'};padding:14px">${h}${qH}${fw}${flH}${ft}</div>`+(pi<pages.length-1?'<br clear="all" style="page-break-before:always">':'');
  }).join('');
  return `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" dir="${d.dir}"><head><meta charset="utf-8"><style>body{font-family:Arial,sans-serif;font-size:${V('rfs')}px;color:${V('ctxt')||'#000'}}table{border-collapse:collapse}td,th{font-size:${V('rfs')}px}.fr{display:inline-table}.ft{border-bottom:1px solid #000}</style></head><body>${body}</body></html>`;
}
