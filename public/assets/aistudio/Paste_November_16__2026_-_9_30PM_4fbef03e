function togPen(){penOn=!penOn;$('penBar').classList.toggle('on',penOn);$('penBtn').classList.toggle('on',penOn);document.querySelectorAll('#wrap .a4').forEach(a=>a.classList.toggle('pen-on',penOn));}
function setPenM(m){penMode=m;['smart','line','arrow','free'].forEach(k=>$('pm-'+k).classList.toggle('on',k===m));}
function bindPen(svg){
  let el=null,pts=[];
  const pt=ev=>{const r=svg.getBoundingClientRect();return[(ev.clientX-r.left)*794/r.width,(ev.clientY-r.top)*1123/r.height];};
  const mk=tag=>{const e=document.createElementNS('http://www.w3.org/2000/svg',tag);e.setAttribute('stroke',V('pCol'));e.setAttribute('stroke-width',V('pW'));e.setAttribute('stroke-linecap','round');e.setAttribute('stroke-linejoin','round');if(C('pDash'))e.setAttribute('stroke-dasharray','7,5');return e;};
  const snapPt=(x1,y1,x2,y2)=>{
    const dx=Math.abs(x2-x1),dy=Math.abs(y2-y1);
    if(dy<Math.max(12,dx*0.12))return[x2,y1];
    if(dx<Math.max(12,dy*0.12))return[x1,y2];
    return[x2,y2];
  };
  const addArrowHead=(x1,y1,x2,y2)=>{
    const ang=Math.atan2(y2-y1,x2-x1),sz=12,p=mk('path');
    p.setAttribute('fill','none');p.removeAttribute('stroke-dasharray');
    p.setAttribute('d',`M${(x2-sz*Math.cos(ang-0.5)).toFixed(1)},${(y2-sz*Math.sin(ang-0.5)).toFixed(1)} L${x2.toFixed(1)},${y2.toFixed(1)} L${(x2-sz*Math.cos(ang+0.5)).toFixed(1)},${(y2-sz*Math.sin(ang+0.5)).toFixed(1)}`);
    svg.appendChild(p);
  };
  svg.addEventListener('pointerdown',ev=>{
    if(!penOn)return;ev.preventDefault();try{svg.setPointerCapture(ev.pointerId);}catch(e){}
    snap();const[x,y]=pt(ev);pts=[[x,y]];
    if(penMode==='line'||penMode==='arrow'){
      el=mk('line');el.setAttribute('x1',x);el.setAttribute('y1',y);el.setAttribute('x2',x);el.setAttribute('y2',y);
    }else{
      el=mk('path');el.setAttribute('d',`M${x.toFixed(1)},${y.toFixed(1)}`);el.setAttribute('fill','none');
    }
    svg.appendChild(el);
  });
  svg.addEventListener('pointermove',ev=>{
    if(!el)return;const[x,y]=pt(ev);pts.push([x,y]);
    if(penMode==='line'||penMode==='arrow'){
      const[sx,sy]=pts[0],[nx,ny]=snapPt(sx,sy,x,y);
      el.setAttribute('x2',nx);el.setAttribute('y2',ny);
    }else{
      el.setAttribute('d',el.getAttribute('d')+` L${x.toFixed(1)},${y.toFixed(1)}`);
    }
  });
  svg.addEventListener('pointerup',()=>{
    if(!el)return;
    if(penMode==='arrow'){
      addArrowHead(+el.getAttribute('x1'),+el.getAttribute('y1'),+el.getAttribute('x2'),+el.getAttribute('y2'));
    }else if(penMode==='smart'&&pts.length>3){
      const[x1,y1]=pts[0],[x2,y2]=pts[pts.length-1],len=Math.hypot(x2-x1,y2-y1);
      if(len>14){
        let maxD=0;pts.forEach(([px,py])=>{const d=Math.abs((y2-y1)*px-(x2-x1)*py+x2*y1-y2*x1)/len;if(d>maxD)maxD=d;});
        if(maxD<Math.max(15,len*0.11)){
          el.remove();const ln=mk('line'),[nx,ny]=snapPt(x1,y1,x2,y2);
          ln.setAttribute('x1',x1);ln.setAttribute('y1',y1);ln.setAttribute('x2',nx);ln.setAttribute('y2',ny);
          svg.appendChild(ln);el=ln;
        }else if(pts.length>6){
          let d=`M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
          for(let i=1;i<pts.length-1;i+=2){const mx=((pts[i][0]+pts[i+1][0])/2).toFixed(1),my=((pts[i][1]+pts[i+1][1])/2).toFixed(1);d+=` Q${pts[i][0].toFixed(1)},${pts[i][1].toFixed(1)} ${mx},${my}`;}
          d+=` L${x2.toFixed(1)},${y2.toFixed(1)}`;
          el.setAttribute('d',d);
        }
      }
    }
    el=null;schedSave();
  });
}
