<html lang="ku" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Nadiyar hussein -kurdi</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Cairo:wght@400;700&family=Lateef:wght@400;700&family=Noto+Kufi+Arabic:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&family=Scheherazade+New:wght@400;700&family=Vazirmatn:wght@400;700&display=swap" rel="stylesheet">
<style>
@font-face{font-family:'Speda';src:url('https://cdn.jsdelivr.net/gh/zFont/main/Fonts/Language/Kurdish/Speda-Bold.ttf') format('truetype');font-display:swap}
@font-face{font-family:'NRT';src:url('https://cdn.jsdelivr.net/gh/zFont/main/Fonts/Language/Kurdish/NRT-Bold.ttf') format('truetype');font-display:swap}
:root{--bg:#fff;--fr:#0f172a;--hd:#000000;--qh:#1e3a8a;--txt:#000000;--fn:'Scheherazade New','Noto Naskh Arabic','Traditional Arabic',serif;--fs:15px}
*{box-sizing:border-box}
body{margin:0;font-family:'Vazirmatn','Noto Naskh Arabic',sans-serif;background:#eef2f6;color:#0f172a;padding-bottom:44px}
.top{position:sticky;top:0;z-index:99;background:#0f172a;color:#fff;padding:7px 10px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:5px;box-shadow:0 2px 8px rgba(0,0,0,.2)}
.top h1{margin:0;font-size:15px;color:#38bdf8}.top small{font-size:11px;color:#cbd5e1;display:block}
.row{display:flex;flex-wrap:wrap;gap:5px;align-items:center}
.btn{border:none;border-radius:7px;padding:6px 10px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer}
.bg{background:#16a34a;color:#fff}.bb{background:#2563eb;color:#fff}.br{background:#dc2626;color:#fff}.bp{background:#7c3aed;color:#fff}.bw{background:#d97706;color:#fff}.bo{background:transparent;border:1px solid #475569;color:#fff}
.lbar{background:#1e293b;color:#e2e8f0;padding:5px 10px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px;font-size:12px}
.lp{padding:3px 10px;border-radius:99px;border:1px solid #475569;background:transparent;color:#cbd5e1;cursor:pointer;font-family:inherit;font-size:12px}
.lp.on{background:#38bdf8;color:#0f172a;border-color:#38bdf8;font-weight:700}
.nsel{background:#0f172a;color:#e2e8f0;border:1px solid #475569;border-radius:6px;padding:3px 6px;font-family:inherit;font-size:11px}
.tabs{max-width:1080px;margin:8px auto 0;padding:0 8px;display:flex;gap:5px;flex-wrap:wrap}
.tab{flex:1;min-width:95px;padding:9px 5px;border-radius:10px;border:1px solid #cbd5e1;background:#fff;font-family:inherit;font-weight:700;font-size:12.5px;cursor:pointer}
.tab.on{background:#1d4ed8;color:#fff;border-color:#1d4ed8}
.tab.ctab.on{background:#0d9488;border-color:#0d9488}
.pan{max-width:1080px;margin:8px auto;padding:0 8px;display:none}.pan.on{display:block}
.card,.tools,.sbar,.pbar2{background:#fff;border:1px solid #cbd5e1;border-radius:10px;padding:10px 12px;margin-bottom:8px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.card h3{margin:0 0 8px;font-size:14px;border-bottom:1px solid #e2e8f0;padding-bottom:6px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px}
.fld label{display:flex;justify-content:space-between;font-size:12px;font-weight:700;margin-bottom:2px}
.fld input[type=text]{width:100%;padding:6px 8px;border:1px solid #cbd5e1;border-radius:6px;font-family:inherit;font-size:12.5px}
.fld input[type=text]:disabled{background:#f1f5f9;color:#475569;cursor:not-allowed}
.lockbar{background:#fef3c7;border:1.5px solid #f59e0b;border-radius:8px;padding:7px 10px;margin-bottom:8px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px;font-size:12px;font-weight:700}
.lockbar.locked{background:#dcfce7;border-color:#16a34a;color:#14532d}
.sbar{display:flex;flex-wrap:wrap;gap:5px;align-items:center;background:#f8fafc}
.si{display:inline-flex;align-items:center;gap:3px;background:#fff;border:1px solid #cbd5e1;padding:3px 6px;border-radius:7px;font-size:11px;font-weight:700}
.si select{border:none;background:transparent;font-family:inherit;font-size:11px;font-weight:700;outline:none;max-width:155px}
.si input[type=number]{width:42px;border:1px solid #e2e8f0;border-radius:4px;text-align:center;font-family:inherit;font-size:12px;font-weight:700;padding:1px}
.si input[type=color]{width:22px;height:19px;border:none;padding:0;background:none;cursor:pointer}
.nb{border:1px solid #cbd5e1;background:#f1f5f9;border-radius:4px;padding:1px 7px;font-weight:700;cursor:pointer;font-size:13px}
.pbar2{background:#fefce8;border-color:#fde047;display:none;flex-wrap:wrap;gap:6px;align-items:center}.pbar2.on{display:flex}
.qgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:6px}
.qbtn{border:none;border-radius:8px;padding:9px 6px;color:#fff;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer}
.tgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px}
.tcard{border:2px solid #cbd5e1;border-radius:12px;padding:10px;text-align:center;cursor:pointer;background:#fff;transition:.15s}
.tcard:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}
.qcard{background:#fff;border:1px solid #cbd5e1;border-inline-start:4px solid #2563eb;border-radius:10px;padding:10px;margin-bottom:9px}
.qcard-top{display:flex;flex-wrap:wrap;gap:6px;align-items:center;justify-content:space-between;border-bottom:1px solid #e2e8f0;padding-bottom:6px;margin-bottom:8px}
.qin{border:1px solid #cbd5e1;border-radius:6px;padding:6px 8px;font-family:inherit;font-size:13.5px;background:#f8fafc;min-height:32px;color:#000}
.qin:focus{outline:2px solid #3b82f6;background:#fff}
.ch{border:1px solid #cbd5e1;background:#f8fafc;color:#0f172a;border-radius:7px;padding:4px 8px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;user-select:none}
.ch.on{background:#dc2626;color:#fff;border-color:#dc2626}
.ch.f{background:#eef2ff;border-color:#a5b4fc;color:#1e3a8a}
.ch.bigfmt{font-size:14.5px;padding:6px 12px;border-width:1.5px;min-width:44px}
.ch.s{background:#ecfdf5;border-color:#6ee7b7;color:#065f46}
.ch.c{background:#fff7ed;border-color:#fdba74;color:#9a3412}
.ch.ar{background:#eff6ff;border-color:#93c5fd;color:#1e40af;font-size:13px;padding:5px 9px}
.cbox{border-radius:9px;padding:8px 10px;margin-top:6px}
.cbox.math{background:#faf5ff;border:1.5px solid #c084fc}
.cbox.bgsec{background:#f0fdf4;border:1.5px solid #4ade80}
.cbox.arsec{background:#eff6ff;border:1.5px solid #60a5fa}
.chdr{display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:800;cursor:pointer}
.mgrid{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:6px}
.mgrid .ch.m{background:#fff;border:1.5px solid #c084fc;color:#4c1d95;font-size:16px;font-weight:800;padding:6px 12px;min-width:52px;border-radius:9px}
.sw{width:22px;height:22px;border-radius:50%;border:2px solid #475569;cursor:pointer;display:inline-block}
.mb{font-size:11px;padding:3px 7px;border-radius:5px;border:1px solid #cbd5e1;background:#f1f5f9;cursor:pointer;font-family:inherit;font-weight:700}
.mb.a{background:#dcfce7;color:#15803d;border-color:#86efac}.mb.d{background:#fee2e2;color:#b91c1c;border-color:#fca5a5}.mb.on{background:#2563eb;color:#fff;border-color:#2563eb}
.tgrp{font-size:12px;font-weight:700;color:#1e293b;margin:4px 0 5px;display:flex;flex-wrap:wrap;gap:5px;align-items:center}
.wrap{display:flex;flex-direction:column;align-items:center;gap:14px;overflow-x:auto;padding:4px 0 12px}
.pbar{width:210mm;max-width:100%;background:#fff;border:1px solid #cbd5e1;border-radius:8px;padding:6px 10px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px;font-size:12px;font-weight:700;margin-bottom:4px}
.pmeter{flex:1;min-width:180px;display:flex;align-items:center;gap:8px}
.pbar-track{flex:1;height:10px;background:#e2e8f0;border-radius:99px;overflow:hidden;min-width:70px}
.pbar-fill{height:100%;background:#16a34a;transition:width .2s,background .2s}
.a4{width:210mm;min-height:297mm;background:var(--bg);color:var(--txt);font-family:var(--fn);font-size:var(--fs);line-height:1.62;padding:12mm 15mm 18mm;position:relative;box-shadow:0 6px 24px rgba(0,0,0,.14);border:2.2px solid var(--fr);overflow:hidden;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
.a4.land{width:297mm;min-height:210mm;padding:14mm 20mm}
.a4.act-a4{box-shadow:0 0 0 3px #2563eb,0 6px 24px rgba(0,0,0,.14)}
.a4.drop-hover{box-shadow:0 0 0 4px #16a34a,0 6px 24px rgba(22,163,74,.28)!important}
.a4.f-double{border-style:double;border-width:6px;padding:14mm 17mm 18mm}
.a4.f-dashed{border-style:dashed;border-width:2.5px}
.a4.f-round{border-radius:18px;border-width:3px}
.a4.f-ornate{border-width:3px;outline:2px solid var(--fr);outline-offset:-7px;padding:15mm 18mm 18mm}
.a4.f-none{border:none}
.forn{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:5}
.a4 [contenteditable="true"]:focus{outline:1.5px dashed #3b82f6;background:rgba(59,130,246,.04);border-radius:3px}
.a4 b,.a4 strong{font-weight:800!important}.a4 i,.a4 em{font-style:italic!important}.a4 u{text-decoration:underline!important;text-underline-offset:3px}
.freewrite{position:relative;z-index:16;min-height:65mm;padding:5px 2px;outline:none;color:#000}
.freewrite:empty::before{content:attr(data-ph);color:#94a3b8;font-size:.9em}
.dsvg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:15}
.a4.pen-on .dsvg{pointer-events:auto;touch-action:none;cursor:crosshair;z-index:45}
.ehdr{border-bottom:2px solid var(--hd);padding-bottom:8px;margin-bottom:12px;color:var(--hd);font-size:.94em;line-height:1.45;position:relative;z-index:16}
.ehdr.hlocked{user-select:none}
.hbis{text-align:center;font-weight:700;margin-bottom:5px;font-size:1.05em}
.hrow{display:flex;justify-content:space-between;align-items:center;gap:12px}
.hcol{display:flex;flex-direction:column;gap:3px}
.hrgt{flex:1.25;text-align:start}.hcen{flex:.85;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4px}
.hlft{flex:1.25;display:flex;flex-direction:column;gap:3px;align-items:stretch}
.hlogo{max-width:120px;max-height:90px;object-fit:contain}
.hbox{border:1.8px solid var(--hd);border-radius:14px;padding:5px 15px;text-align:center;background:rgba(0,0,0,.015)}
.hstu{display:flex;align-items:center;gap:4px;width:100%}
.hstud{flex:1;border-bottom:1.2px dotted var(--hd);min-width:80px;display:inline-block;padding:0 3px}
.hdt{border-top:1px solid #94a3b8;border-bottom:1px solid #94a3b8;padding:2px 0;margin:1px 0;display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;align-items:center}
.hscr{border:1.8px solid var(--hd);padding:1px 11px;border-radius:6px;font-weight:800;display:inline-block;min-width:32px;text-align:center}
.hi{display:inline-flex;align-items:center;gap:2px}
.hd,.id{background:#fee2e2;color:#dc2626;border:1px solid #fecaca;border-radius:4px;width:16px;height:16px;font-size:10px;padding:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;opacity:.55;transition:.15s}
.hd:hover,.id:hover{opacity:1}
.qb{position:relative;margin-bottom:10px;padding-bottom:7px;border-bottom:1px solid #cbd5e1;z-index:16;color:#000}
.qb.nol{border-bottom:none;padding-bottom:2px}
.qb.qfree{position:absolute;z-index:22;background:rgba(255,255,255,.96);border:1.5px dashed #3b82f6;border-radius:6px;padding:5px 8px}
.qb.dragging{opacity:.85;box-shadow:0 8px 24px rgba(37,99,235,.35);z-index:90!important}
.qtools{display:flex;flex-wrap:wrap;gap:3px;margin-bottom:4px;align-items:center;opacity:.92}
.qdh{cursor:grab;touch-action:none;padding:2px 7px;background:#0284c7;color:#fff;border-radius:5px;font-weight:700;font-size:11px;display:inline-flex;align-items:center;gap:3px}
.qrz{position:absolute;bottom:-7px;right:-7px;width:18px;height:18px;background:#2563eb;color:#fff;border-radius:50%;font-size:10px;display:flex;align-items:center;justify-content:center;cursor:nwse-resize;touch-action:none}
.qh{display:flex;justify-content:space-between;align-items:baseline;font-weight:800;color:var(--qh);margin-bottom:5px;gap:10px}
.qi{position:relative;margin-bottom:4px;padding-inline:4px 22px;color:#000}.qi .id{position:absolute;inset-inline-end:0;top:3px}
.mcq{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-top:3px;padding-inline-start:14px}
.mo{display:flex;gap:4px;align-items:baseline;min-width:0}
.cntg{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-top:3px;padding-inline-start:6px}
.cnti{position:relative;display:flex;gap:4px;align-items:baseline;padding-inline-end:18px;min-width:0}
.cnti .id{position:absolute;inset-inline-end:0;top:3px;width:14px;height:14px;font-size:8px}
.mt{width:100%;border-collapse:collapse;margin-top:4px}.mt td{padding:3px 6px;vertical-align:middle;border:1px dashed #cbd5e1}
.hw{border-bottom:1.3px solid #64748b;height:26px;margin-top:3px}
.hw.sm{height:18px}.hw.md{height:26px}.hw.lg{height:36px}
.et{width:100%;height:100%;border-collapse:collapse;table-layout:fixed;background:#fff;color:#000}
.et td,.et th{border:1.2px solid #1e293b;padding:2px 4px;text-align:center;word-wrap:break-word;overflow-wrap:break-word;line-height:1.25;vertical-align:middle}
.et td:focus,.et th:focus{outline:1.5px solid #2563eb;background:#eff6ff}
.cmap{display:flex;flex-direction:column;align-items:center;gap:8px;padding:6px 0}
.cnode{border:1.5px solid #1e293b;border-radius:8px;padding:4px 12px;min-width:90px;text-align:center;font-weight:700;position:relative}
.cbranch{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}
/* Larger, easy-to-edit Math Widgets */
.fr{display:inline-flex;flex-direction:column;align-items:center;vertical-align:middle;margin:0 4px;line-height:1.15;font-size:1.05em;font-weight:700}
.ft{border-bottom:1.8px solid currentColor;padding:1px 7px;min-width:22px;text-align:center}
.fb{padding:1px 7px;min-width:22px;text-align:center}
.rtw{display:inline-flex;align-items:flex-end;vertical-align:middle;margin:0 4px;font-weight:700;font-size:1.08em}
.rt-i{font-size:.78em;min-width:12px;text-align:center;margin-bottom:8px;margin-inline-end:-2px;padding:0 2px;border-bottom:1px dashed transparent}
.rt-i:focus{border-bottom-color:#7c3aed}
.rt-s{font-size:1.38em;line-height:1;font-weight:800}
.rt-b{border-top:2px solid currentColor;padding:1px 8px 0;min-width:26px;text-align:center;line-height:1.2}
.pww{display:inline-flex;align-items:baseline;vertical-align:middle;margin:0 3px;font-weight:700;font-size:1.05em}
.pw-b{padding:0 2px;min-width:14px;text-align:center}
.pw-t{font-size:.82em;padding:0 4px;min-width:14px;text-align:center;border:1px dashed rgba(124,58,237,.35);border-radius:4px;margin-inline-start:1px}
.mcirc{width:100%;height:100%;border:2.4px solid #000;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fff;overflow:hidden;color:#000}
.mcirc div{width:100%;text-align:center;font-weight:800;line-height:1.15;padding:1px 0}.mcirc div:first-child{border-bottom:2px solid #000}
.medcirc{width:100%;height:100%;border:2px solid #0d9488;border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;background:#f0fdfa;overflow:hidden;color:#000}
.freetxt{width:100%;height:100%;padding:5px 8px;border:1px dashed #94a3b8;border-radius:6px;background:transparent;outline:none;color:#000}
.freetxt.nobdr{border-color:transparent!important}
.fel{position:absolute;z-index:25;border:1.5px dashed transparent;padding:2px;cursor:move;touch-action:none}
.fel[data-ftbl="1"]{padding:8px 3px 3px;border:1.5px dashed #cbd5e1;background:rgba(255,255,255,.9)}
.fel[data-ftbl="1"] td,.fel[data-ftbl="1"] th{touch-action:auto;cursor:text}
.fel:hover,.fel.sel{border-color:#3b82f6;background:rgba(59,130,246,.04)}
.fel.locked{cursor:default!important;border-color:transparent!important}
.fel.locked .dh,.fel.locked .rzh{display:none!important}
.fel.locked:hover .fc{display:flex}
.fc{position:absolute;top:-32px;right:0;background:#0f172a;color:#fff;border-radius:7px;padding:3px 6px;display:none;gap:4px;align-items:center;font-size:11px;white-space:nowrap;z-index:40;box-shadow:0 3px 10px rgba(0,0,0,.25)}
.fel:hover .fc,.fel.sel .fc{display:flex}
.fc button{background:#334155;color:#fff;border:none;border-radius:4px;padding:2px 7px;cursor:pointer;font-size:11.5px;font-weight:700}
.fc button.fd{background:#dc2626}.fc button.pin{background:#0284c7}.fc button.pin.on{background:#16a34a}
.fc input[type=color]{width:20px;height:18px;border:none;padding:0;background:none;cursor:pointer}
.dh{cursor:move;touch-action:none;padding:2px 6px;background:#0284c7;color:#fff;border-radius:4px;font-weight:700;display:inline-block}
.rzh{position:absolute;bottom:-9px;right:-9px;width:20px;height:20px;background:#2563eb;color:#fff;border-radius:50%;font-size:11px;display:none;align-items:center;justify-content:center;cursor:nwse-resize;touch-action:none;z-index:35}
.fel:hover .rzh,.fel.sel .rzh{display:flex}
.sl{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;font-weight:700;padding:6px;color:#000}
.efoot{position:absolute;bottom:7mm;left:15mm;right:15mm;text-align:center;font-weight:700;font-size:.92em;color:var(--hd);z-index:16}
.addpg{display:flex;justify-content:center;margin:6px 0 20px}
@media(max-width:820px){.a4{zoom:.46}.a4.land{zoom:.34}}
@media print{
  body{background:#fff!important;padding:0!important;margin:0!important}
  .np,.top,.lbar,.tabs,.tools,.sbar,.pbar,.pbar2,.qtools,.qrz,.hd,.id,.fc,.rzh,.addpg{display:none!important}
  .freewrite:empty::before{content:''!important}
  .pw-t,.rt-i{border-color:transparent!important}
  body:not(.cert-mode) #p-hdr,body:not(.cert-mode) #p-qs,body:not(.cert-mode) #p-tpl{display:none!important}
  body:not(.cert-mode) #p-work{display:block!important;margin:0!important;padding:0!important;max-width:100%!important}
  body.cert-mode #p-hdr,body.cert-mode #p-qs,body.cert-mode #p-work{display:none!important}
  body.cert-mode #p-tpl{display:block!important;margin:0!important;padding:0!important;max-width:100%!important}
  body.cert-mode #p-tpl .card{display:none!important}
  .wrap{display:block!important;padding:0!important}
  .a4{zoom:1!important;box-shadow:none!important;margin:0!important;page-break-after:always;break-after:page;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .pbox:last-child .a4{page-break-after:auto;break-after:auto}
  .fel,.fel[data-ftbl="1"],.qb.qfree,.freetxt{border-color:transparent!important;background:transparent!important;padding:0!important}
  .qb.nol{border-bottom-color:transparent!important}
  .mt td{border-color:transparent!important}
}
</style>
