    corner=`<g id="cf"><path d="M18,18 C45,18 65,28 76,52 C54,48 36,36 18,18Z" fill="${c3}" opacity=".35"/><path d="M18,18 C18,45 28,65 52,76 C48,54 36,36 18,18Z" fill="${c1}" opacity=".3"/><circle cx="28" cy="28" r="10" fill="${c1}" opacity=".85"/><circle cx="44" cy="22" r="7" fill="${c3}" opacity=".8"/><circle cx="22" cy="44" r="7" fill="${c3}" opacity=".8"/><circle cx="28" cy="28" r="4" fill="${c2}"/><path d="M14,95 C14,35 35,14 95,14" fill="none" stroke="${c2}" stroke-width="2.5"/></g>`;
  }else if(t==='classic-geo'){
    corner=`<g id="cf"><rect x="14" y="14" width="44" height="44" fill="none" stroke="${c2}" stroke-width="2.5"/><rect x="24" y="24" width="24" height="24" transform="rotate(45 36 36)" fill="${c1}" opacity=".22" stroke="${c1}" stroke-width="2"/><path d="M14,84 L84,14" stroke="${c2}" stroke-width="1.8"/></g>`;
  }else if(t==='double-ornate'){
    corner=`<g id="cf"><path d="M12,70 L12,12 L70,12 M22,52 L22,22 L52,22" fill="none" stroke="${c1}" stroke-width="2.5"/><circle cx="22" cy="22" r="5" fill="${c2}"/></g>`;
  }else{
    corner=`<g id="cf"><path d="M14,80 L14,14 L80,14 M22,60 C22,28 28,22 60,22" fill="none" stroke="${c2}" stroke-width="3"/><circle cx="28" cy="28" r="4" fill="${c1}"/></g>`;
  }
  return `<svg class="forn" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><defs>${corner}</defs>
    <rect x="12" y="12" width="${W-24}" height="${H-24}" rx="10" fill="none" stroke="${c1}" stroke-width="5"/>
    <rect x="22" y="22" width="${W-44}" height="${H-44}" rx="6" fill="none" stroke="${c2}" stroke-width="2"/>
    <use href="#cf"/><use href="#cf" transform="translate(${W},0) scale(-1,1)"/><use href="#cf" transform="translate(0,${H}) scale(1,-1)"/><use href="#cf" transform="translate(${W},${H}) scale(-1,-1)"/>
  </svg>`;
}

