    'purple':['#6d28d9','#eab308','#8b5cf6'],
    'classic-geo':['#1e3a8a','#b45309','#0284c7'],
    'double-ornate':['#0f172a','#0d9488','#475569']
  }[t]||['#0d9488','#eab308','#14b8a6'];
  const[c1,c2,c3]=pal, fl=t==='turq-gold'||t==='emerald'||t==='purple';
